.venv/
.venv/
__pycache__/
fcv_gauntlet/oracle/.spend_ledger.json
*.py[cod]
*.replay*
replay.replay*
*.db
*.log
.fcode/
local_bots/
docs/superpowers/
*.zip
*.log
.cursor/
.DS_Store
.aider*
artifacts/
# Generated by optuna/tune_bot.py — local, disposable snapshots of whatever
# bot was passed via --bot (<bot>_baseline is frozen via --freeze-baseline;
# <bot>_trial is rebuilt fresh every run with a tuning hook injected).
# Reproducible on demand, so committing either would go stale and conflict
# across machines. Globbed, not just optuna/count_*, since --bot works for
# any bot under bots/ (e.g. optuna/baron_baseline/, optuna/baron_trial/).
optuna/*_baseline/
optuna/*_trial/

# Local caches of past ladder submissions, downloaded on demand by
# scripts/version_bracket.py and scripts/milestone_gauntlet.py via
# `fcode submission download`. Regenerated from the ladder, not source.
submission_cache/
bots/_milestones/

# Generated by optuna/discover_params.py — a point-in-time scan of a bot's
# source, regenerate on demand rather than commit (goes stale the moment
# the bot's constants change).
optuna/discovered_*.json

# Per-trial/per-matchup/per-bracket-round scratch from optuna/tune_bot.py
# and scripts/version_bracket.py — high volume (one dir per trial or per
# bracket match) and regenerated every run. Distinct from
# test_results/multi_bot_gauntlet/ etc., which are deliberately committed
# campaign reports — this rule only covers the optuna/bracket scratch.
test_results/optuna_*/
test_results/version_bracket/

# Downloaded real match replays, cached by scripts/ladder_report.py.
# Re-downloadable from the platform on demand, not source.
ladder_replay_cache/

# Default output of optuna/materialize_trial.py — regenerable from a study
# or a saved params.json. Pass an explicit --out elsewhere (outside this
# pattern) for a copy you actually want to keep/commit/diff in a PR.
bots/*_tuned/
